---
interface Heading {
	slug: string;
	text: string;
	depth: number;
}

interface Props {
	headings?: Heading[];
}

const { headings = [] } = Astro.props;
const toc = headings.filter((h) => h.depth <= 2);
---

{
	toc.length > 0 && (
		<aside title="On this page" class="hidden w-56 shrink-0 p-4 lg:block">
			<nav aria-label="On this page">
				<h2 class="mb-2 font-semibold text-slate-700">On this page</h2>
				<ul class="flex flex-col gap-1.5 text-sm">
					{toc.map((heading) => (
						<li>
							<a href={`#${heading.slug}`} class="text-slate-500 hover:text-slate-900">
								{heading.text}
							</a>
						</li>
					))}
				</ul>
			</nav>
		</aside>
	)
}
