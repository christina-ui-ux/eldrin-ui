---
import { getCollection } from 'astro:content';
import { SIDEBAR } from '../config';
import { withBase } from '../lib/base';

interface Props {
	currentPage: string;
}

const { currentPage } = Astro.props;

const decisions = (await getCollection('decisions')).sort((a, b) => b.data.id - a.data.id);

const isCurrent = (link: string) => currentPage === withBase(link);

const linkClasses = (link: string) =>
	[
		'block border-l py-1.5 pl-4 my-0.5 transition-colors hover:border-slate-400 hover:text-slate-900',
		isCurrent(link) ? 'border-slate-900 text-slate-900 font-medium' : 'border-transparent text-slate-500',
	].join(' ');
---

<aside title="Site navigation" class="w-64 shrink-0 border-r border-slate-200 p-4">
	<nav aria-label="Documentation">
		<ul>
			{
				SIDEBAR.map((item) =>
					'header' in item && item.header ? (
						<h2 class="mt-4 font-semibold text-slate-700 first:mt-0">{item.text}</h2>
					) : (
						<li>
							<a href={withBase(item.link!)} class={linkClasses(item.link!)}>
								{item.text}
							</a>
						</li>
					)
				)
			}

			<h2 class="mt-4 font-semibold text-slate-700">Architecture decisions</h2>
			{
				decisions.map((decision) => {
					const link = `/decisions/${decision.data.id}/`;
					return (
						<li>
							<a href={withBase(link)} class={linkClasses(link)}>
								{String(decision.data.id).padStart(4, '0')} — {decision.data.title}
							</a>
						</li>
					);
				})
			}
		</ul>
	</nav>
</aside>
